#!/bin/bash
# skill-budget — keep the workflow skills from growing without limit.
# Prints each tracked file's line count against its budget; exits 1 if any file is over.
# Run at the end of every retrospective, before proposing an edit and after making it.
#
# Budgets: SKILL.md 200 lines, each reference file 350, CHANGELOG.md 150.
# Scans plugins/*/skills/* when run inside a checkout of the n8io/ai repo; otherwise scans
# the skills of the installed n8io plugins.

set -uo pipefail

JQ=$(command -v jq || command -v jaq || true)

roots=()
top=$(git rev-parse --show-toplevel 2>/dev/null || true)
if [[ -n "$top" && -d "$top/plugins" && -f "$top/.claude-plugin/marketplace.json" ]]; then
  for d in "$top"/plugins/*/skills; do [[ -d "$d" ]] && roots+=("$d"); done
elif [[ -n "$JQ" ]] && command -v claude >/dev/null 2>&1; then
  while IFS= read -r p; do [[ -d "$p/skills" ]] && roots+=("$p/skills"); done < <(
    claude plugin list --json 2>/dev/null | "$JQ" -r '.[] | select(.id | endswith("@n8io")) | .installPath'
  )
fi

if (( ${#roots[@]} == 0 )); then
  echo "skill-budget: no n8io skills found (run inside the n8io/ai repo or install the plugins)" >&2
  exit 0
fi

over=0
check() {
  local file="$1" budget="$2" n
  [[ -f "$file" ]] || return 0
  n=$(wc -l <"$file" | tr -d ' ')
  local mark="ok"
  if (( n > budget )); then mark="OVER"; over=1; fi
  printf '%-5s %4d / %-4d %s\n' "$mark" "$n" "$budget" "${file#$HOME/}"
}

for root in "${roots[@]}"; do
  for dir in "$root"/*/; do
    dir="${dir%/}"
    check "$dir/SKILL.md" 200
    check "$dir/CHANGELOG.md" 150
    if [[ -d "$dir/references" ]]; then
      for ref in "$dir"/references/*.md; do check "$ref" 350; done
    fi
  done
done

exit $over
