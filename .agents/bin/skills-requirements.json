{
  "skills": {
    "ship": ["skill:idea-to-tickets", "skill:ticket-worker", "skill:next-issue", "skill:ticket-loop", "skill:progress-tracker", "bin:cs", "bin:skill-budget", "cli:tmux", "session:chrome", "session:messaging"],
    "idea-to-tickets": ["skill:grill-with-docs", "cli:gh"],
    "ticket-worker": ["skill:next-issue", "skill:stack-notes", "bin:gh-wait", "bin:glossary-check", "session:chrome"],
    "next-issue": ["skill:stack-notes", "skill:gh-events", "skill:commit", "plugin:superpowers", "bin:gh-wait", "cli:gh", "cli:git"],
    "ticket-loop": ["skill:ticket-worker", "skill:next-issue", "bin:cs", "bin:skill-budget", "cli:tmux"],
    "parallel-tickets": ["skill:ticket-worker", "skill:next-issue", "bin:skill-budget"],
    "slack-triage": ["skill:slack", "skill:idea-to-tickets", "bin:slack-download", "cli:slackcli", "mcp:slack"],
    "progress-tracker": [],
    "stack-notes": [],
    "gh-events": ["bin:gh-wait"]
  },
  "requirements": {
    "skill:idea-to-tickets": { "provider": "ai-config" },
    "skill:ticket-worker": { "provider": "ai-config" },
    "skill:next-issue": { "provider": "ai-config" },
    "skill:ticket-loop": { "provider": "ai-config" },
    "skill:stack-notes": { "provider": "ai-config" },
    "skill:commit": { "provider": "ai-config" },
    "skill:progress-tracker": { "provider": "ai-config" },
    "skill:gh-events": { "provider": "ai-config" },
    "skill:slack": { "provider": "ai-config" },
    "skill:grill-with-docs": { "install": "bunx skills add mattpocock/skills --skill grill-with-docs -g -y" },
    "plugin:superpowers": {
      "check": "claude plugin list 2>/dev/null | grep -q 'superpowers@claude-plugins-official'",
      "install": "claude plugin install superpowers@claude-plugins-official"
    },
    "bin:cs": { "provider": "ai-config" },
    "bin:skill-budget": { "provider": "ai-config" },
    "bin:glossary-check": { "provider": "ai-config" },
    "bin:gh-wait": { "provider": "ai-config", "requires": ["cli:node", "cli:gh", "gh-ext:cli/gh-webhook"] },
    "bin:slack-download": { "provider": "ai-config", "requires": ["cli:jq", "cli:curl"] },
    "cli:gh": { "install": "brew install gh", "then": "gh auth login (device code: send the user the URL)" },
    "cli:git": { "install": "brew install git" },
    "cli:tmux": { "install": "brew install tmux" },
    "cli:node": { "install": "brew install node" },
    "cli:jq": { "install": "brew install jq" },
    "cli:curl": { "install": "brew install curl" },
    "cli:slackcli": { "human": "Install slackcli and sign in to the Slack workspace in a browser" },
    "gh-ext:cli/gh-webhook": {
      "check": "gh extension list 2>/dev/null | grep -q 'cli/gh-webhook'",
      "install": "gh extension install cli/gh-webhook"
    },
    "mcp:slack": { "session": "mcp__claude_ai_Slack__", "human": "Connect the Slack connector at https://claude.ai/settings/connectors" },
    "session:chrome": { "session": "mcp__claude-in-chrome__", "human": "Install the Claude in Chrome extension and start the session with --chrome (cs does)" },
    "session:messaging": { "session": "CLAUDE_CODE_MESSAGING_SOCKET", "human": "Start the session with cs so workers can message it" }
  }
}
