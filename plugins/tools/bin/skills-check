#!/usr/bin/env python3
"""skills-check — list what a workflow skill needs that this machine is missing.

Usage:
  skills-check <skill>...            report missing requirements for these skills (and what they use)
  skills-check --all                 check every skill in the list
  skills-check --install <id>...     run the install command for requirements the user approved

Requirements live in skills-requirements.json next to this script. Kinds:
  skill:<name>  shipped by a plugin ("provider"), or found under ~/.claude/skills, ~/.agents/skills
                or an installed plugin's skills/ dir (CLAUDE_CONFIG_DIR replaces ~/.claude)
  plugin:, gh-ext:  checked with the entry's "check" command
  bin:<name>    shipped by a plugin ("provider"), or on PATH
  cli:<name>    on PATH
  mcp:, session:  only the running session can see these; listed so it checks them itself

An entry's optional "cloud" names its equivalent in a claude.ai cloud session (CLAUDE_CODE_REMOTE
or CLAUDE_CODE_PROJECTS_SESSION set). There a missing entry with a "cloud" equivalent is listed
under "Cloud equivalents" instead of counting as missing.

Exit 0 when nothing is missing, 1 otherwise. Never installs without --install.
"""
import glob
import json
import os
import shutil
import subprocess
import sys

HOME = os.path.expanduser("~")
CONFIG = os.environ.get("CLAUDE_CONFIG_DIR") or os.path.join(HOME, ".claude")
HERE = os.path.dirname(os.path.realpath(__file__))
REQS = json.load(open(os.path.join(HERE, "skills-requirements.json")))
CLOUD = os.environ.get("CLAUDE_CODE_REMOTE") == "true" or bool(os.environ.get("CLAUDE_CODE_PROJECTS_SESSION"))
SKILLS, ITEMS = REQS["skills"], REQS["requirements"]


def closure(names):
    seen, order, stack = set(), [], [f"skill:{n}" for n in names]
    while stack:
        rid = stack.pop()
        if rid in seen:
            continue
        seen.add(rid)
        order.append(rid)
        kind, _, name = rid.partition(":")
        if kind == "skill" and name in SKILLS:
            stack.extend(SKILLS[name])
        stack.extend(ITEMS.get(rid, {}).get("requires", []))
    return order


def present(rid):
    kind, _, name = rid.partition(":")
    item = ITEMS.get(rid, {})
    if "check" in item:
        return subprocess.run(item["check"], shell=True).returncode == 0
    if kind == "skill":
        dirs = [os.path.join(CONFIG, "skills"), os.path.join(HOME, ".agents", "skills")]
        dirs += glob.glob(os.path.join(CONFIG, "plugins", "cache", "*", "*", "*", "skills"))
        return any(os.path.isfile(os.path.join(d, name, "SKILL.md")) for d in dirs)
    if kind == "bin":
        return bool(shutil.which(name))
    if kind == "cli":
        return bool(shutil.which(name))
    return None  # mcp:, session: — the session checks these


def report(names):
    unknown = [n for n in names if n not in SKILLS]
    if unknown:
        print(f"skills-check: not in the list: {', '.join(unknown)}", file=sys.stderr)
    installable, human, session, cloud, offered = [], [], [], [], set()
    for rid in closure([n for n in names if n in SKILLS]):
        item = ITEMS.get(rid, {})
        if CLOUD and "cloud" in item and not present(rid):
            cloud.append(f"  {rid}  — {item['cloud']}")
            continue
        provider = item.get("provider")
        if provider and ITEMS.get(provider, {}).get("check"):
            # Shipped by one of our plugins: present when that plugin is installed.
            if present(provider) or present(rid):
                continue
            if provider not in offered:
                offered.add(provider)
                installable.append(f"  {provider}  — `{ITEMS[provider]['install']}`")
            continue
        ok = present(rid)
        if ok is None:
            session.append(f"  {rid}  (session check: {item.get('session', '?')}; if missing: {item.get('human', '')})")
        elif not ok:
            if "install" in item:
                then = f"; then {item['then']}" if "then" in item else ""
                installable.append(f"  {rid}  — `{item['install']}`{then}")
            else:
                human.append(f"  {rid}  — {item.get('human', 'install by hand')}")
    if installable:
        print("Missing, installable by the session (skills-check --install <id>):", *installable, sep="\n")
    if human:
        print("Missing, other:", *human, sep="\n")
    if session:
        print("Check in the session:", *session, sep="\n")
    if cloud:
        print("Cloud equivalents (use these instead):", *cloud, sep="\n")
    if not installable and not human:
        print("skills-check: nothing missing" + (" (session checks above still apply)" if session else ""))
        return 0
    return 1


def install(ids):
    rc = 0
    for rid in ids:
        cmd = ITEMS.get(rid, {}).get("install")
        if not cmd:
            print(f"skills-check: {rid} has no install command", file=sys.stderr)
            rc = 1
            continue
        print(f"$ {cmd}")
        rc |= subprocess.run(cmd, shell=True).returncode
    return 1 if rc else 0


def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__.strip())
        return 0
    if argv[0] == "--install":
        return install(argv[1:])
    if argv[0] == "--all":
        return report(list(SKILLS))
    return report(argv)


sys.exit(main(sys.argv[1:]))
