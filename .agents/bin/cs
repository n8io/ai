#!/bin/bash
# cs — start a Claude Code session the standard way:
# inside tmux, permissions bypassed, Claude in Chrome on, Remote Control named after the repo and branch.
#
#   cs                 # name from repo + branch, e.g. "the-golf-league - main"
#   cs "Firefighter"   # custom Remote Control name
#   cs -- --resume     # everything after -- goes to claude unchanged
#
# Inside tmux it runs in the current pane. Outside, it creates (or reattaches to) a tmux session.

set -euo pipefail

label=""
if [[ $# -gt 0 && "$1" != "--" ]]; then label="$1"; shift; fi
[[ "${1:-}" == "--" ]] && shift

root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
repo="$(basename "$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null | sed 's#/\.git$##' || echo "$root")")"
branch="$(git branch --show-current 2>/dev/null || true)"
[[ -z "$label" ]] && label="$repo${branch:+ - $branch}"

# tmux session names cannot contain '.' or ':'; keep them short and readable.
slug="$(printf '%s' "$label" | tr -cs 'A-Za-z0-9_-' '-' | sed 's/^-*//;s/-*$//' | cut -c1-40)"

cmd=(claude --name "$slug" --remote-control "$label" --permission-mode bypassPermissions --chrome "$@")

# A folder Claude Code has never opened shows a "trust this folder?" screen, and Remote Control
# does not connect until someone answers it. When the folder is a git repo whose GitHub owner is
# trusted, answer it once from a short background watcher. Anywhere else the screen stays for a
# human. Trusted owners: $CS_TRUST_OWNERS (space-separated), else the logged-in gh user.
owned_repo() {
  local url owner owners
  url="$(git remote get-url origin 2>/dev/null)" || return 1
  owner="$(printf '%s' "$url" | sed -nE 's#.*github\.com[:/]([^/]+)/.*#\1#p')"
  [[ -n "$owner" ]] || return 1
  owners="${CS_TRUST_OWNERS:-$(gh api user --jq .login 2>/dev/null)}"
  [[ " $owners " == *" $owner "* ]]
}
answer_trust() {
  local target="$1"
  owned_repo || return 0
  ( for _ in $(seq 1 40); do
      sleep 0.5
      if tmux capture-pane -p -t "$target" 2>/dev/null | grep -q 'Yes, I trust this folder'; then
        tmux send-keys -t "$target" Down Enter
        exit 0
      fi
    done ) >/dev/null 2>&1 &
}

if [[ -n "${TMUX:-}" ]]; then
  answer_trust "${TMUX_PANE:-}"
  exec "${cmd[@]}"
fi

if tmux has-session -t "=$slug" 2>/dev/null; then
  exec tmux attach -t "=$slug"
fi
tmux new-session -d -s "$slug" -c "$PWD" "${cmd[@]}"
answer_trust "=$slug"
exec tmux attach -t "=$slug"
